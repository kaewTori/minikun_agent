<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minikun.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/kaewtori/Library/Application Support/Minikun/java/script/minikun-agent.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kaewtori/Library/Application Support/Minikun/java/minikun_agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>JAVA_BIN</key>
        <string>/usr/bin/java</string>
        <key>JDK_JAVA_OPTIONS</key>
        <string>--enable-native-access=ALL-UNNAMED</string>
        <key>OLLAMA_NATIVE_BASE_URL</key>
        <string>http://127.0.0.1:11434</string>
        <key>MINIKUN_HTTPS_ENABLED</key>
        <string>true</string>
        <key>MINIKUN_HTTPS_PORT</key>
        <string>8443</string>
        <key>MINIKUN_VOICE_TTS_WARMUP</key>
        <string>false</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/kaewtori/Library/Logs/Minikun/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kaewtori/Library/Logs/Minikun/launchd.err.log</string>
</dict>
</plist>
