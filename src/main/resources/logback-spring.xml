<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="CHAT_TRANSACTION_LOG_PATH"
              value="${CHAT_TRANSACTION_LOG_PATH:-logs/transactions.log}" />
    <property name="CHAT_TRANSACTION_LOG_MAX_HISTORY"
              value="${CHAT_TRANSACTION_LOG_MAX_HISTORY:-5}" />
    <property name="APPLICATION_LOG_PATH"
              value="${APPLICATION_LOG_PATH:-logs/application.log}" />
    <property name="APPLICATION_LOG_MAX_HISTORY"
              value="${APPLICATION_LOG_MAX_HISTORY:-14}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,Asia/Bangkok} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CHAT_TRANSACTION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${CHAT_TRANSACTION_LOG_PATH}</file>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${CHAT_TRANSACTION_LOG_PATH}.%d{yyyy-MM-dd,Asia/Bangkok}</fileNamePattern>
            <maxHistory>${CHAT_TRANSACTION_LOG_MAX_HISTORY}</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="APPLICATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${APPLICATION_LOG_PATH}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,Asia/Bangkok} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${APPLICATION_LOG_PATH}.%d{yyyy-MM-dd,Asia/Bangkok}</fileNamePattern>
            <maxHistory>${APPLICATION_LOG_MAX_HISTORY}</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="com.minikun.agent.minikun_agent.api.openai.ChatTransactionLogger"
            level="INFO"
            additivity="false">
        <appender-ref ref="CHAT_TRANSACTION_FILE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="APPLICATION_FILE" />
    </root>
</configuration>